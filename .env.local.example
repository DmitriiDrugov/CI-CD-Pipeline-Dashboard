# Optional: Add a GitHub Personal Access Token for higher rate limits (5000 req/hr vs 60 req/hr)
# Create one at https://github.com/settings/tokens (no special scopes needed for public repos)
GITHUB_TOKEN=your_token_here

# Azure Serverless Backend
# Set to "true" to route /api/workflow-stats requests through the Azure Function instead of
# computing the result locally. Requires AZURE_FUNCTION_URL to be set as well.
USE_AZURE_BACKEND=false

# Base URL of the deployed Azure Function app (no trailing slash).
# Example: https://my-function-app.azurewebsites.net
# Only required when USE_AZURE_BACKEND=true.
AZURE_FUNCTION_URL=
